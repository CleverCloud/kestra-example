#!/usr/bin/env bash
#MISE description="Build the app"
set -euo pipefail

# Create the internal storage bucket on Cellar (no-op if it already exists)
pip install --quiet s3cmd
cat > ~/.s3cfg << EOF2
[default]
access_key = $CELLAR_ADDON_KEY_ID
secret_key = $CELLAR_ADDON_KEY_SECRET
host_base = $CELLAR_ADDON_HOST
host_bucket = $CELLAR_ADDON_HOST
use_https = True
EOF2
s3cmd ls "s3://$BUCKET_NAME" > /dev/null 2>&1 || s3cmd mb "s3://$BUCKET_NAME"

# Download the pinned Kestra executable jar and verify its checksum
KESTRA_RELEASE_URL="https://github.com/kestra-io/kestra/releases/download/v$KESTRA_VERSION"
mkdir -p "$APP_HOME/kestra-install"
cd "$APP_HOME/kestra-install"
wget -nv "$KESTRA_RELEASE_URL/kestra-$KESTRA_VERSION" -O "kestra-$KESTRA_VERSION"
wget -nv "$KESTRA_RELEASE_URL/checksums_sha256.txt" -O checksums_sha256.txt
sha256sum --check --ignore-missing checksums_sha256.txt
ln -sf "$APP_HOME/kestra-install/kestra-$KESTRA_VERSION" "$APP_HOME/kestra"

# Install the MinIO (S3-compatible) internal storage plugin
mkdir -p "$KESTRA_PLUGINS_PATH"
java -jar "$APP_HOME/kestra" plugins install \
  "io.kestra.storage:storage-minio:$KESTRA_STORAGE_MINIO_VERSION" \
  --plugins "$KESTRA_PLUGINS_PATH"
